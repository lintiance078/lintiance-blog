---
// ============================================================
// SearchBox - 模态搜索弹窗（重写版）
// 点击导航搜索图标 → 弹出居中模态弹窗
// 仅回车键触发搜索，无实时搜索/联想
// 关闭方式：ESC / 点击外部空白
// 纯前端 Pagefind 静态搜索
// ============================================================
---

<!-- 搜索触发按钮在 Header 中 -->
<!-- 模态弹窗结构 -->

<div id="search-modal-overlay" class="search-modal-overlay">
  <div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="search-modal-header">
      <span class="search-modal-title">🔍 搜索文章</span>
      <button class="search-modal-close" id="search-modal-close" aria-label="关闭搜索">&times;</button>
    </div>
    <div class="search-modal-body">
      <input
        type="text"
        class="search-modal-input"
        id="search-modal-input"
        placeholder="输入关键词，按回车搜索..."
        autocomplete="off"
      />
      <div class="search-modal-results" id="search-modal-results">
        <p class="search-modal-hint">输入关键词后按 Enter 搜索</p>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const overlay = document.getElementById('search-modal-overlay');
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-modal-input') as HTMLInputElement;
    const resultsContainer = document.getElementById('search-modal-results');
    const closeBtn = document.getElementById('search-modal-close');

    let pagefindInstance: any = null;
    let pagefindReady = false;

    // 初始化 Pagefind
    async function initPagefind() {
      try {
        const checkResp = await fetch('/pagefind/pagefind.js', { method: 'HEAD' });
        if (!checkResp.ok) {
          throw new Error('Pagefind 索引未构建');
        }
        const pagefind = await import('/pagefind/pagefind.js');
        pagefindInstance = pagefind;
        pagefindReady = true;
        console.log('[搜索] Pagefind 索引已加载');
      } catch {
        pagefindReady = false;
        console.log('[搜索] Pagefind 不可用，搜索仅在构建后生效');
      }
    }

    // 打开搜索弹窗
    function openSearch() {
      overlay?.classList.add('active');
      // 延迟聚焦，确保动画完成
      setTimeout(() => {
        input?.focus();
        input?.select();
      }, 150);
      document.body.style.overflow = 'hidden';
    }

    // 关闭搜索弹窗
    function closeSearch() {
      overlay?.classList.remove('active');
      document.body.style.overflow = '';
      if (input) input.value = '';
      if (resultsContainer) {
        resultsContainer.innerHTML = '<p class="search-modal-hint">输入关键词后按 Enter 搜索</p>';
      }
    }

    // 执行搜索
    async function doSearch(query: string) {
      if (!resultsContainer) return;
      const q = query.trim();
      if (!q) {
        resultsContainer.innerHTML = '<p class="search-modal-hint">输入关键词后按 Enter 搜索</p>';
        return;
      }

      if (!pagefindReady) {
        resultsContainer.innerHTML = '<p class="search-modal-empty">🔍 搜索功能将在构建后可用（npm run build）</p>';
        return;
      }

      resultsContainer.innerHTML = '<div class="search-modal-loading"><div class="spinner"></div><span>搜索中...</span></div>';

      try {
        const search = await pagefindInstance.search(q, { pageLength: 10 });
        if (!search || search.results.length === 0) {
          resultsContainer.innerHTML = '<p class="search-modal-empty">未找到与 "<strong>' + escapeHtml(q) + '</strong>" 相关的文章</p>';
          return;
        }

        const results = search.results.slice(0, 10);
        const htmlPromises = results.map(async (result: any) => {
          const data = await result.data();
          return `
            <a class="search-result-item" href="${data.url}">
              <span class="search-result-title">${data.meta?.title || data.url}</span>
              <span class="search-result-excerpt">${data.excerpt || ''}</span>
            </a>
          `;
        });

        const htmls = await Promise.all(htmlPromises);
        let html = htmls.join('');
        if (search.results.length > 10) {
          html += `<p class="search-modal-count">显示前 10 条，共 ${search.results.length} 条结果</p>`;
        }
        resultsContainer.innerHTML = html;
      } catch (e) {
        console.error('[搜索] 出错:', e);
        resultsContainer.innerHTML = '<p class="search-modal-empty">搜索出错，请稍后重试</p>';
      }
    }

    function escapeHtml(str: string): string {
      const div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // 事件绑定
    if (input) {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          doSearch(input.value);
        } else if (e.key === 'Escape') {
          closeSearch();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSearch);
    }

    // 点击外部空白关闭
    if (overlay) {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          closeSearch();
        }
      });
    }

    // ESC 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay?.classList.contains('active')) {
        closeSearch();
      }
      // Ctrl+K 打开搜索
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
    });

    // 暴露全局方法
    (window as any).__searchModal = { open: openSearch, close: closeSearch };

    // 初始化
    initPagefind();
  })();
</script>