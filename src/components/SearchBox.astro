---
// ============================================================
// SearchBox - 模态搜索弹窗（重写版）
// 点击导航搜索图标 → 弹出居中模态弹窗
// 仅回车键触发搜索，无实时搜索/联想
// 关闭方式：ESC / 点击外部空白
// 纯前端 Pagefind 静态搜索
// ============================================================
---

<!-- 搜索触发按钮在 Header 中 -->
<!-- 模态弹窗结构 -->

<div id="search-modal-overlay" class="search-modal-overlay">
  <div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="search-modal-header">
      <span class="search-modal-title">🔍 搜索文章</span>
      <button class="search-modal-close" id="search-modal-close" aria-label="关闭搜索">&times;</button>
    </div>
    <div class="search-modal-body">
      <input
        type="text"
        class="search-modal-input"
        id="search-modal-input"
        placeholder="输入关键词，按回车搜索..."
        autocomplete="off"
      />
      <div class="search-modal-results" id="search-modal-results">
        <p class="search-modal-hint">输入关键词后按 Enter 搜索</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var overlay = document.getElementById('search-modal-overlay');
    var modal = document.getElementById('search-modal');
    var input = document.getElementById('search-modal-input');
    var resultsContainer = document.getElementById('search-modal-results');
    var closeBtn = document.getElementById('search-modal-close');

    var pagefindInstance = null;
    var pagefindReady = false;

    // 初始化 Pagefind
    async function initPagefind() {
      try {
        var checkResp = await fetch('/pagefind/pagefind.js', { method: 'HEAD' });
        if (!checkResp.ok) {
          throw new Error('Pagefind 索引未构建');
        }
        var pagefind = await import('/pagefind/pagefind.js');
        pagefindInstance = pagefind;
        pagefindReady = true;
        console.log('[搜索] Pagefind 索引已加载');
      } catch (e) {
        pagefindReady = false;
        console.log('[搜索] Pagefind 不可用，搜索仅在构建后生效');
      }
    }

    // 打开搜索弹窗
    function openSearch() {
      if (overlay) overlay.classList.add('active');
      setTimeout(function() {
        if (input) {
          input.focus();
          input.select();
        }
      }, 150);
      document.body.style.overflow = 'hidden';
    }

    // 关闭搜索弹窗
    function closeSearch() {
      if (overlay) overlay.classList.remove('active');
      document.body.style.overflow = '';
      if (input) input.value = '';
      if (resultsContainer) {
        resultsContainer.innerHTML = '<p class="search-modal-hint">输入关键词后按 Enter 搜索</p>';
      }
    }

    // 执行搜索
    async function doSearch(query) {
      if (!resultsContainer) return;
      var q = query.trim();
      if (!q) {
        resultsContainer.innerHTML = '<p class="search-modal-hint">输入关键词后按 Enter 搜索</p>';
        return;
      }

      if (!pagefindReady) {
        resultsContainer.innerHTML = '<p class="search-modal-empty">🔍 搜索功能将在构建后可用（npm run build）</p>';
        return;
      }

      resultsContainer.innerHTML = '<div class="search-modal-loading"><div class="spinner"></div><span>搜索中...</span></div>';

      try {
        var search = await pagefindInstance.search(q, { pageLength: 20 });
        if (!search || search.results.length === 0) {
          resultsContainer.innerHTML = '<p class="search-modal-empty">未找到与 "<strong>' + escapeHtml(q) + '</strong>" 相关的文章</p>';
          return;
        }

        var allResults = await Promise.all(
          search.results.map(function(result) { return result.data(); })
        );

        // 过滤：非黑客模式下隐藏黑客文章
        var isHackerMode = document.documentElement.classList.contains('hacker-mode');
        var filteredResults = allResults.filter(function(data) {
          var url = data.url || '';
          var isHackerUrl = url.indexOf('/posts/hacker-') !== -1;
          if (isHackerMode) return isHackerUrl;
          return !isHackerUrl;
        });

        if (filteredResults.length === 0) {
          resultsContainer.innerHTML = '<p class="search-modal-empty">未找到与 "<strong>' + escapeHtml(q) + '</strong>" 相关的文章</p>';
          return;
        }

        var displayResults = filteredResults.slice(0, 10);
        var html = displayResults.map(function(data) {
          return '<a class="search-result-item" href="' + data.url + '">' +
            '<span class="search-result-title">' + (data.meta ? data.meta.title : data.url) + '</span>' +
            '<span class="search-result-excerpt">' + (data.excerpt || '') + '</span>' +
            '</a>';
        }).join('');

        if (filteredResults.length > 10) {
          html += '<p class="search-modal-count">显示前 10 条，共 ' + filteredResults.length + ' 条结果</p>';
        }
        resultsContainer.innerHTML = html;
      } catch (e) {
        console.error('[搜索] 出错:', e);
        resultsContainer.innerHTML = '<p class="search-modal-empty">搜索出错，请稍后重试</p>';
      }
    }

    function escapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML;
    }

    // 事件绑定
    if (input) {
      input.addEventListener('keydown', async function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          var value = input.value.trim();

          var hackerReady = window.__hackerModeReady;
          if (hackerReady && value) {
            var success = await window.__triggerHackerMode(value);
            if (success) {
              input.value = '';
              closeSearch();
              return;
            }
            doSearch(value);
            return;
          }

          doSearch(value);
        } else if (e.key === 'Escape') {
          closeSearch();
        }
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeSearch);
    }

    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
          closeSearch();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay && overlay.classList.contains('active')) {
        closeSearch();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        openSearch();
      }
    });

    window.__searchModal = { open: openSearch, close: closeSearch };

    initPagefind();
  })();
</script>