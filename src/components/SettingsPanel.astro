---
// ============================================================
// SettingsPanel - 扩展版侧边设置面板 v3
// 所有设置 localStorage 本地生效，支持精细配置项
// 简约模式使用 data-simple-mode 属性
// 包含站点健康检测（替代悬浮球）
// ============================================================
import HealthCheck from '@components/HealthCheck.astro';
---

<div id="settings-overlay" class="settings-overlay"></div>

<aside id="settings-panel" class="settings-panel">
  <div class="settings-panel-header">
    <h3 class="settings-panel-title">⚙️ 设置</h3>
    <button class="settings-panel-close"
      onclick="document.getElementById('settings-panel')?.classList.remove('active');document.getElementById('settings-overlay')?.classList.remove('active');document.body.style.overflow=''"
      aria-label="关闭设置">✕</button>
  </div>

  <div class="settings-panel-body">
    <!-- 主题 -->
    <div class="settings-section">
      <h4 class="settings-section-title">🎨 主题</h4>
      <div class="theme-toggle-group">
        <button class="theme-btn active" data-theme-value="light" onclick="setTheme('light')">☀️ 浅色</button>
        <button class="theme-btn" data-theme-value="dark" onclick="setTheme('dark')">🌙 深色</button>
      </div>
    </div>

    <!-- 简约模式 -->
    <div class="settings-section">
      <h4 class="settings-section-title">🧩 简约模式</h4>
      <div class="settings-item">
        <span class="settings-label">简约模式</span>
        <label class="toggle-switch">
          <input type="checkbox" id="toggle-minimal" onchange="toggleSimpleMode(this.checked)">
          <span class="toggle-slider"></span>
        </label>
      </div>
      <p class="settings-hint">关闭毛玻璃、圆角、阴影、渐变、hover及动画，使用朴素样式</p>
    </div>

    <!-- 文章列表布局 -->
    <div class="settings-section">
      <h4 class="settings-section-title">📐 文章列表布局</h4>
      <div class="settings-radio-group" data-setting="layout">
        <label class="settings-radio"><input type="radio" name="layout" value="grid" checked onchange="applySetting('layout',this.value);showLayoutConfig(this.value)"> Grid 均等网格</label>
        <label class="settings-radio"><input type="radio" name="layout" value="masonry" onchange="applySetting('layout',this.value);showLayoutConfig(this.value)"> Masonry 瀑布流</label>
        <label class="settings-radio"><input type="radio" name="layout" value="list" onchange="applySetting('layout',this.value);showLayoutConfig(this.value)"> List 纯列表</label>
        <label class="settings-radio"><input type="radio" name="layout" value="card-list" onchange="applySetting('layout',this.value);showLayoutConfig(this.value)"> Card-List 混合</label>
        <label class="settings-radio"><input type="radio" name="layout" value="timeline" onchange="applySetting('layout',this.value);showLayoutConfig(this.value)"> Timeline 时间轴</label>
      </div>
      <!-- 布局专属配置区 -->
      <div id="layout-config-area" class="settings-sub-config" style="display:none"></div>
    </div>

    <!-- 导航交互 -->
    <div class="settings-section">
      <h4 class="settings-section-title">🧭 导航交互</h4>
      <div class="settings-radio-group" data-setting="nav-style">
        <label class="settings-radio"><input type="radio" name="nav-style" value="static" checked onchange="applySetting('nav-style',this.value);showNavConfig(this.value)"> 静态导航</label>
        <label class="settings-radio"><input type="radio" name="nav-style" value="sticky" onchange="applySetting('nav-style',this.value);showNavConfig(this.value)"> Sticky 固定置顶</label>
        <label class="settings-radio"><input type="radio" name="nav-style" value="scroll-hide" onchange="applySetting('nav-style',this.value);showNavConfig(this.value)"> 下滑隐藏/上滑显示</label>
        <label class="settings-radio"><input type="radio" name="nav-style" value="transparent" onchange="applySetting('nav-style',this.value);showNavConfig(this.value)"> 滚动透明渐变</label>
        <label class="settings-radio"><input type="radio" name="nav-style" value="shrink" onchange="applySetting('nav-style',this.value);showNavConfig(this.value)"> 滚动收缩导航</label>
      </div>
      <div id="nav-config-area" class="settings-sub-config" style="display:none"></div>
    </div>

    <!-- 卡片风格 -->
    <div class="settings-section">
      <h4 class="settings-section-title">🃏 卡片风格</h4>
      <div class="settings-radio-group" data-setting="card-style">
        <label class="settings-radio"><input type="radio" name="card-style" value="shadow" checked onchange="applySetting('card-style',this.value);showCardConfig(this.value)"> 圆角阴影悬浮</label>
        <label class="settings-radio"><input type="radio" name="card-style" value="borderless" onchange="applySetting('card-style',this.value);showCardConfig(this.value)"> 简约无边框</label>
        <label class="settings-radio"><input type="radio" name="card-style" value="cover-top" onchange="applySetting('card-style',this.value);showCardConfig(this.value)"> 封面图置顶</label>
        <label class="settings-radio"><input type="radio" name="card-style" value="blur-cover" onchange="applySetting('card-style',this.value);showCardConfig(this.value)"> 背景虚化封面</label>
      </div>
      <div id="card-config-area" class="settings-sub-config" style="display:none"></div>
    </div>

    <!-- 侧边栏组件 -->
    <div class="settings-section">
      <h4 class="settings-section-title">📑 侧边栏组件</h4>
      <div class="settings-item">
        <span class="settings-label">常驻侧边栏</span>
        <label class="toggle-switch"><input type="checkbox" id="toggle-sidebar" onchange="applyToggleSidebar('sidebar',this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item">
        <span class="settings-label">抽屉侧边面板</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-drawer" onchange="applyToggleSidebar('drawer',this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item">
        <span class="settings-label">文章悬浮 TOC</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-toc" onchange="applyToggleSidebar('toc',this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item" id="toc-highlight-item" style="display:none">
        <span class="settings-label" style="padding-left:1rem;font-size:0.8rem">└ 阅读位置高亮</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-toc-highlight" onchange="setSettingValue('tocHighlight',this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item">
        <span class="settings-label">标签云</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-tagcloud" onchange="applyToggleSidebar('tagcloud',this.checked)"><span class="toggle-slider"></span></label>
      </div>
    </div>

    <!-- 毛玻璃 -->
    <div class="settings-section">
      <h4 class="settings-section-title">🫧 毛玻璃效果</h4>
      <div class="settings-item">
        <span class="settings-label">总开关</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-glass" onchange="applyGlassFull(this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item" id="glass-intensity-item">
        <span class="settings-label">模糊强度</span>
        <select id="glass-intensity" class="settings-select" onchange="applyGlassIntensity(this.value)">
          <option value="low">低 (4px)</option>
          <option value="mid" selected>中 (8px)</option>
          <option value="high">高 (16px)</option>
        </select>
      </div>
    </div>

    <!-- 页面动效 -->
    <div class="settings-section">
      <h4 class="settings-section-title">✨ 页面动效</h4>
      <div class="settings-item">
        <span class="settings-label">总开关</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-animation" onchange="applyAnimationFull(this.checked)"><span class="toggle-slider"></span></label>
      </div>
      <div class="settings-item" id="anim-mode-item">
        <span class="settings-label">动画模式</span>
        <select id="anim-mode" class="settings-select" onchange="applyAnimMode(this.value)">
          <option value="fade" selected>淡入淡出</option>
          <option value="slide">滑动推入</option>
          <option value="scale">缩放</option>
          <option value="flip">翻转</option>
        </select>
      </div>
      <div class="settings-item" id="anim-duration-item">
        <span class="settings-label">动画时长</span>
        <select id="anim-duration" class="settings-select" onchange="applyAnimDuration(this.value)">
          <option value="fast">快 (150ms)</option>
          <option value="normal" selected>标准 (300ms)</option>
          <option value="slow">慢 (600ms)</option>
        </select>
      </div>
      <div class="settings-item" id="anim-card-item">
        <span class="settings-label">卡片视口入场动画</span>
        <label class="toggle-switch"><input type="checkbox" checked id="toggle-card-anim" onchange="setSettingValue('cardAnim',this.checked)"><span class="toggle-slider"></span></label>
      </div>
    </div>

    <!-- 站点信息 -->
    <div class="settings-section">
      <h4 class="settings-section-title">📋 站点信息</h4>
      <div class="settings-group">
        <div class="settings-item">
          <span class="settings-label">站点名称</span>
          <span style="font-size:0.85rem;color:var(--text-secondary)" id="config-site-title">林天策 Blog</span>
        </div>
        <div class="settings-item">
          <span class="settings-label">作者</span>
          <span style="font-size:0.85rem;color:var(--text-secondary)" id="config-author">Blog Author</span>
        </div>
        <div class="settings-item">
          <span class="settings-label">构建工具</span>
          <span style="font-size:0.85rem;color:var(--text-secondary)">Astro</span>
        </div>
        <div class="settings-item">
          <span class="settings-label">部署平台</span>
          <span style="font-size:0.85rem;color:var(--text-secondary)">Cloudflare Pages</span>
        </div>
      </div>
    </div>

    <!-- 站点健康检测 -->
    <div class="settings-section">
      <h4 class="settings-section-title">💓 站点健康检测</h4>
      <p class="settings-hint">检测页面资源加载、关键页面可访问性、浏览器存储等功能状态</p>
      <HealthCheck />
    </div>
  </div>
</aside>

<script>
  // ============================================================
  // 设置管理器 v3 - 全功能版本
  // ============================================================
  (function() {
    const STORAGE_KEY = 'lintiance_settings';

    const defaults = {
      layout: 'grid',
      layoutConfig: {
        masonry: { cols: 1, perPage: 12, minWidth: 280 },
        grid: { cols: 3, perPage: 12, minWidth: 280 },
        list: { thumbSize: 'medium', dense: false },
        'card-list': { pinnedCount: 3, perPage: 10 },
        timeline: { lineStyle: 'solid', lineColor: '#6366f1', dotSize: 'medium', perPage: 15 },
      },
      'nav-style': 'static',
      navConfig: {
        'scroll-hide': { threshold: 80 },
        'transparent': { threshold: 50 },
        'shrink': { shrinkHeight: 48 },
      },
      'card-style': 'shadow',
      cardConfig: {
        shadow: { radius: 'lg', shadowIntensity: 'md', hoverLift: 3 },
        borderless: { dividerWeight: 1, dividerOpacity: 0.5 },
        'cover-top': { coverHeight: 'tall' },
        'blur-cover': { blurIntensity: 'mid' },
      },
      sidebar: true,
      drawer: true,
      toc: true,
      tocHighlight: true,
      tagcloud: true,
      glass: true,
      glassIntensity: 'mid',
      animation: true,
      animMode: 'fade',
      animDuration: 'normal',
      cardAnim: true,
    };

    function getSettings() {
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        return stored ? deepMerge(defaults, JSON.parse(stored)) : { ...defaults };
      } catch { return { ...defaults }; }
    }

    function deepMerge(target, source) {
      const result = { ...target };
      for (const key in source) {
        if (source[key] && typeof source[key] === 'object' && !Array.isArray(source[key])) {
          result[key] = deepMerge(target[key] || {}, source[key]);
        } else {
          result[key] = source[key];
        }
      }
      return result;
    }

    function saveSettings(settings) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
    }

    function setSettingValue(key, value) {
      const settings = getSettings();
      settings[key] = value;
      saveSettings(settings);
      applyToDOM(settings);
    }

    // 应用设置到 DOM
    function applyToDOM(settings) {
      const html = document.documentElement;

      // 布局
      html.setAttribute('data-layout', settings.layout);
      const lc = settings.layoutConfig?.[settings.layout] || {};
      Object.entries(lc).forEach(([k, v]) => html.setAttribute('data-layout-' + k, String(v)));

      // 瀑布流列数 → CSS 变量
      const masonryCols = settings.layoutConfig?.masonry?.cols || 1;
      html.style.setProperty('--masonry-cols', String(masonryCols));

      // 网格列数 → CSS 变量
      const gridCols = settings.layoutConfig?.grid?.cols || 3;
      html.style.setProperty('--grid-cols', String(gridCols));

      // 导航
      html.setAttribute('data-nav-style', settings['nav-style']);
      const nc = settings.navConfig?.[settings['nav-style']] || {};
      Object.entries(nc).forEach(([k, v]) => html.setAttribute('data-nav-' + k, String(v)));

      // 卡片样式
      html.setAttribute('data-card-style', settings['card-style']);
      const cc = settings.cardConfig?.[settings['card-style']] || {};
      Object.entries(cc).forEach(([k, v]) => html.setAttribute('data-card-' + k, String(v)));

      // 毛玻璃
      html.classList.toggle('no-glass', !settings.glass);
      html.setAttribute('data-glass', settings.glass ? settings.glassIntensity : 'off');

      // 毛玻璃强度 → CSS 变量
      const glassBlurMap = { low: '4px', mid: '8px', high: '16px' };
      const glassBlur = settings.glass ? (glassBlurMap[settings.glassIntensity] || '8px') : '0px';
      html.style.setProperty('--glass-blur', glassBlur);

      // 动效
      html.classList.toggle('no-animation', !settings.animation);
      html.setAttribute('data-anim-mode', settings.animMode);
      html.setAttribute('data-anim-duration', settings.animDuration);
      html.classList.toggle('no-card-anim', !settings.cardAnim);

      // 侧边栏
      html.classList.toggle('no-sidebar', !settings.sidebar);
      html.classList.toggle('no-drawer', !settings.drawer);
      html.classList.toggle('no-toc', !settings.toc);
      html.classList.toggle('no-toc-highlight', !settings.tocHighlight);
      html.classList.toggle('no-tagcloud', !settings.tagcloud);

      // 侧边栏 DOM 控制
      const sidebar = document.getElementById('site-sidebar');
      if (sidebar) {
        if (settings.sidebar) {
          sidebar.classList.add('visible');
          document.body.classList.add('has-sidebar');
        } else {
          sidebar.classList.remove('visible');
          document.body.classList.remove('has-sidebar');
        }
      }
    }

    // 初始化控件
    function initControls() {
      const settings = getSettings();

      // 单选按钮
      document.querySelectorAll('.settings-radio-group').forEach(group => {
        const setting = group.dataset.setting;
        if (setting && settings[setting]) {
          const radio = group.querySelector(`input[value="${settings[setting]}"]`);
          if (radio) radio.checked = true;
        }
      });

      // 开关
      const toggleIds = {
        'toggle-sidebar': 'sidebar', 'toggle-drawer': 'drawer',
        'toggle-toc': 'toc', 'toggle-toc-highlight': 'tocHighlight',
        'toggle-tagcloud': 'tagcloud', 'toggle-glass': 'glass',
        'toggle-animation': 'animation', 'toggle-card-anim': 'cardAnim',
      };
      Object.entries(toggleIds).forEach(([id, key]) => {
        const el = document.getElementById(id);
        if (el) el.checked = settings[key] !== false;
      });

      // 下拉菜单
      const glassSelect = document.getElementById('glass-intensity');
      if (glassSelect) glassSelect.value = settings.glassIntensity || 'mid';
      const animMode = document.getElementById('anim-mode');
      if (animMode) animMode.value = settings.animMode || 'fade';
      const animDur = document.getElementById('anim-duration');
      if (animDur) animDur.value = settings.animDuration || 'normal';

      // 简约模式
      const minimalToggle = document.getElementById('toggle-minimal');
      if (minimalToggle) {
        minimalToggle.checked = document.documentElement.hasAttribute('data-simple-mode');
      }

      // 显示当前布局/导航/卡片的配置
      showLayoutConfig(settings.layout);
      showNavConfig(settings['nav-style']);
      showCardConfig(settings['card-style']);

      // TOC高亮子项
      const tocHi = document.getElementById('toc-highlight-item');
      if (tocHi) tocHi.style.display = settings.toc ? '' : 'none';

      // 玻璃强度
      const glassInt = document.getElementById('glass-intensity-item');
      if (glassInt) glassInt.style.display = settings.glass ? '' : 'none';

      // 动画子项
      const animItems = ['anim-mode-item', 'anim-duration-item', 'anim-card-item'];
      animItems.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = settings.animation ? '' : 'none';
      });

      applyToDOM(settings);
    }

    // ============== 布局配置 ==============
    window.showLayoutConfig = function(layout) {
      const area = document.getElementById('layout-config-area');
      if (!area) return;
      const settings = getSettings();
      const lc = settings.layoutConfig?.[layout] || {};

      let html = '';
      switch (layout) {
        case 'masonry':
          html = `
            <div class="settings-item">
              <span class="settings-label">列数 (1-4)</span>
              <select class="settings-select" onchange="setLayoutConfig('masonry','cols',this.value)">
                ${[1,2,3,4].map(n => `<option value="${n}" ${lc.cols==n?'selected':''}>${n} 列</option>`).join('')}
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">单页文章上限</span>
              <select class="settings-select" onchange="setLayoutConfig('masonry','perPage',this.value)">
                ${[6,12,18,24,36].map(n => `<option value="${n}" ${lc.perPage==n?'selected':''}>${n} 篇</option>`).join('')}
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">卡片最小宽度</span>
              <select class="settings-select" onchange="setLayoutConfig('masonry','minWidth',this.value)">
                ${[240,280,320,360].map(n => `<option value="${n}" ${lc.minWidth==n?'selected':''}>${n}px</option>`).join('')}
              </select>
            </div>
            <p class="settings-hint">瀑布流默认单列显示；JS加载失败自动降级为均等网格</p>`;
          break;
        case 'grid':
          html = `
            <div class="settings-item">
              <span class="settings-label">列数 (1-4)</span>
              <select class="settings-select" onchange="setLayoutConfig('grid','cols',this.value)">
                ${[1,2,3,4].map(n => `<option value="${n}" ${lc.cols==n?'selected':''}>${n} 列</option>`).join('')}
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">单页文章上限</span>
              <select class="settings-select" onchange="setLayoutConfig('grid','perPage',this.value)">
                ${[6,12,18,24,36].map(n => `<option value="${n}" ${lc.perPage==n?'selected':''}>${n} 篇</option>`).join('')}
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">卡片最小宽度</span>
              <select class="settings-select" onchange="setLayoutConfig('grid','minWidth',this.value)">
                ${[240,280,320,360].map(n => `<option value="${n}" ${lc.minWidth==n?'selected':''}>${n}px</option>`).join('')}
              </select>
            </div>`;
          break;
        case 'list':
          html = `
            <div class="settings-item">
              <span class="settings-label">缩略图尺寸</span>
              <select class="settings-select" onchange="setLayoutConfig('list','thumbSize',this.value)">
                <option value="small" ${lc.thumbSize=='small'?'selected':''}>小</option>
                <option value="medium" ${lc.thumbSize=='medium'?'selected':''}>中</option>
                <option value="large" ${lc.thumbSize=='large'?'selected':''}>大</option>
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">高密度模式</span>
              <label class="toggle-switch"><input type="checkbox" ${lc.dense?'checked':''} onchange="setLayoutConfig('list','dense',this.checked)"><span class="toggle-slider"></span></label>
            </div>`;
          break;
        case 'card-list':
          html = `
            <div class="settings-item">
              <span class="settings-label">置顶卡片数量</span>
              <select class="settings-select" onchange="setLayoutConfig('card-list','pinnedCount',this.value)">
                ${[1,2,3,4,5].map(n => `<option value="${n}" ${lc.pinnedCount==n?'selected':''}>${n} 张</option>`).join('')}
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">单页文章上限</span>
              <select class="settings-select" onchange="setLayoutConfig('card-list','perPage',this.value)">
                ${[6,10,15,20].map(n => `<option value="${n}" ${lc.perPage==n?'selected':''}>${n} 篇</option>`).join('')}
              </select>
            </div>`;
          break;
        case 'timeline':
          html = `
            <div class="settings-item">
              <span class="settings-label">轴线样式</span>
              <select class="settings-select" onchange="setLayoutConfig('timeline','lineStyle',this.value)">
                <option value="solid" ${lc.lineStyle=='solid'?'selected':''}>实线</option>
                <option value="dashed" ${lc.lineStyle=='dashed'?'selected':''}>虚线</option>
                <option value="dotted" ${lc.lineStyle=='dotted'?'selected':''}>点线</option>
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">轴线颜色</span>
              <input type="color" value="${lc.lineColor||'#6366f1'}" onchange="setLayoutConfig('timeline','lineColor',this.value)" style="width:40px;height:28px;border:none;cursor:pointer">
            </div>
            <div class="settings-item">
              <span class="settings-label">节点大小</span>
              <select class="settings-select" onchange="setLayoutConfig('timeline','dotSize',this.value)">
                <option value="small" ${lc.dotSize=='small'?'selected':''}>小</option>
                <option value="medium" ${lc.dotSize=='medium'?'selected':''}>中</option>
                <option value="large" ${lc.dotSize=='large'?'selected':''}>大</option>
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">单页文章上限</span>
              <select class="settings-select" onchange="setLayoutConfig('timeline','perPage',this.value)">
                ${[10,15,20,30].map(n => `<option value="${n}" ${lc.perPage==n?'selected':''}>${n} 篇</option>`).join('')}
              </select>
            </div>
            <p class="settings-hint">时间轴强制按发布时间倒序，不执行置顶逻辑</p>`;
          break;
      }
      area.innerHTML = html;
      area.style.display = html ? '' : 'none';
    };

    window.setLayoutConfig = function(layout, key, value) {
      const settings = getSettings();
      if (!settings.layoutConfig) settings.layoutConfig = {};
      if (!settings.layoutConfig[layout]) settings.layoutConfig[layout] = {};
      settings.layoutConfig[layout][key] = typeof value === 'string' && !isNaN(value) ? parseInt(value) : value;
      saveSettings(settings);
      applyToDOM(settings);
    };

    // ============== 导航配置 ==============
    window.showNavConfig = function(style) {
      const area = document.getElementById('nav-config-area');
      if (!area) return;
      const settings = getSettings();
      const nc = settings.navConfig?.[style] || {};

      let html = '';
      switch (style) {
        case 'scroll-hide':
          html = `<div class="settings-item">
            <span class="settings-label">滚动触发阈值 (px)</span>
            <input type="range" min="20" max="200" value="${nc.threshold||80}" oninput="setNavConfig('scroll-hide','threshold',this.value)" style="width:100%">
            <span style="font-size:0.75rem;color:var(--text-tertiary)">${nc.threshold||80}px</span>
          </div>`;
          break;
        case 'transparent':
          html = `<div class="settings-item">
            <span class="settings-label">透明度切换阈值 (px)</span>
            <input type="range" min="20" max="200" value="${nc.threshold||50}" oninput="setNavConfig('transparent','threshold',this.value)" style="width:100%">
            <span style="font-size:0.75rem;color:var(--text-tertiary)">${nc.threshold||50}px</span>
          </div>`;
          break;
        case 'shrink':
          html = `<div class="settings-item">
            <span class="settings-label">收缩后导航高度 (px)</span>
            <input type="range" min="32" max="56" value="${nc.shrinkHeight||48}" oninput="setNavConfig('shrink','shrinkHeight',this.value)" style="width:100%">
            <span style="font-size:0.75rem;color:var(--text-tertiary)">${nc.shrinkHeight||48}px</span>
          </div>`;
          break;
      }
      area.innerHTML = html;
      area.style.display = html ? '' : 'none';
    };

    window.setNavConfig = function(style, key, value) {
      const settings = getSettings();
      if (!settings.navConfig) settings.navConfig = {};
      if (!settings.navConfig[style]) settings.navConfig[style] = {};
      settings.navConfig[style][key] = parseInt(value);
      saveSettings(settings);
      applyToDOM(settings);
      showNavConfig(style);
    };

    // ============== 卡片风格配置 ==============
    window.showCardConfig = function(style) {
      const area = document.getElementById('card-config-area');
      if (!area) return;
      const settings = getSettings();
      const cc = settings.cardConfig?.[style] || {};

      let html = '';
      switch (style) {
        case 'shadow':
          html = `
            <div class="settings-item">
              <span class="settings-label">圆角档位</span>
              <select class="settings-select" onchange="setCardConfig('shadow','radius',this.value)">
                <option value="sm" ${cc.radius=='sm'?'selected':''}>小 (6px)</option>
                <option value="md" ${cc.radius=='md'?'selected':''}>中 (10px)</option>
                <option value="lg" ${cc.radius=='lg'?'selected':''}>大 (16px)</option>
                <option value="xl" ${cc.radius=='xl'?'selected':''}>超大 (20px)</option>
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">阴影强度</span>
              <select class="settings-select" onchange="setCardConfig('shadow','shadowIntensity',this.value)">
                <option value="sm" ${cc.shadowIntensity=='sm'?'selected':''}>轻</option>
                <option value="md" ${cc.shadowIntensity=='md'?'selected':''}>中</option>
                <option value="lg" ${cc.shadowIntensity=='lg'?'selected':''}>重</option>
              </select>
            </div>
            <div class="settings-item">
              <span class="settings-label">hover 上浮幅度</span>
              <select class="settings-select" onchange="setCardConfig('shadow','hoverLift',this.value)">
                ${[0,2,3,5,8].map(n => `<option value="${n}" ${cc.hoverLift==n?'selected':''}>${n}px</option>`).join('')}
              </select>
            </div>`;
          break;
        case 'borderless':
          html = `
            <div class="settings-item">
              <span class="settings-label">分割线粗细 (px)</span>
              <input type="range" min="0" max="3" step="0.5" value="${cc.dividerWeight||1}" oninput="setCardConfig('borderless','dividerWeight',this.value)" style="width:100%">
              <span style="font-size:0.75rem">${cc.dividerWeight||1}px</span>
            </div>
            <div class="settings-item">
              <span class="settings-label">分割线透明度</span>
              <input type="range" min="0.1" max="1" step="0.1" value="${cc.dividerOpacity||0.5}" oninput="setCardConfig('borderless','dividerOpacity',this.value)" style="width:100%">
              <span style="font-size:0.75rem">${cc.dividerOpacity||0.5}</span>
            </div>`;
          break;
        case 'cover-top':
          html = `
            <div class="settings-item">
              <span class="settings-label">封面高度档位</span>
              <select class="settings-select" onchange="setCardConfig('cover-top','coverHeight',this.value)">
                <option value="short" ${cc.coverHeight=='short'?'selected':''}>矮 (120px)</option>
                <option value="medium" ${cc.coverHeight=='medium'?'selected':''}>中 (200px)</option>
                <option value="tall" ${cc.coverHeight=='tall'?'selected':''}>高 (280px)</option>
              </select>
            </div>`;
          break;
        case 'blur-cover':
          html = `
            <div class="settings-item">
              <span class="settings-label">封面虚化强度</span>
              <select class="settings-select" onchange="setCardConfig('blur-cover','blurIntensity',this.value)">
                <option value="low" ${cc.blurIntensity=='low'?'selected':''}>低 (2px)</option>
                <option value="mid" ${cc.blurIntensity=='mid'?'selected':''}>中 (4px)</option>
                <option value="high" ${cc.blurIntensity=='high'?'selected':''}>高 (8px)</option>
              </select>
            </div>`;
          break;
      }
      area.innerHTML = html;
      area.style.display = html ? '' : 'none';
    };

    window.setCardConfig = function(style, key, value) {
      const settings = getSettings();
      if (!settings.cardConfig) settings.cardConfig = {};
      if (!settings.cardConfig[style]) settings.cardConfig[style] = {};
      settings.cardConfig[style][key] = typeof value === 'string' && !isNaN(value) ? parseFloat(value) : value;
      saveSettings(settings);
      applyToDOM(settings);
    };

    // ============== 全局方法 ==============
    window.setTheme = function(theme) {
      document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
      const btn = document.querySelector(`[data-theme-value="${theme}"]`);
      if (btn) btn.classList.add('active');
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('rin_theme', JSON.stringify(theme));
    };

    window.applySetting = function(key, value) {
      const settings = getSettings();
      settings[key] = value;
      saveSettings(settings);
      applyToDOM(settings);
    };

    window.applyToggle = function(key, value) {
      setSettingValue(key, value);
    };

    window.applyToggleSidebar = function(key, value) {
      setSettingValue(key, value);
      if (key === 'toc') {
        const tocHi = document.getElementById('toc-highlight-item');
        if (tocHi) tocHi.style.display = value ? '' : 'none';
      }
      if (key === 'sidebar') {
        // 侧边栏开关：控制 DOM 显示/隐藏
        const sidebar = document.getElementById('site-sidebar');
        if (sidebar) {
          if (value) {
            sidebar.classList.add('visible');
            document.body.classList.add('has-sidebar');
          } else {
            sidebar.classList.remove('visible');
            document.body.classList.remove('has-sidebar');
          }
        }
      }
    };

    window.applyGlassFull = function(enabled) {
      setSettingValue('glass', enabled);
      const glassInt = document.getElementById('glass-intensity-item');
      if (glassInt) glassInt.style.display = enabled ? '' : 'none';
    };

    window.applyGlassIntensity = function(value) {
      setSettingValue('glassIntensity', value);
    };

    window.applyAnimationFull = function(enabled) {
      setSettingValue('animation', enabled);
      ['anim-mode-item', 'anim-duration-item', 'anim-card-item'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.style.display = enabled ? '' : 'none';
      });
    };

    window.applyAnimMode = function(value) {
      setSettingValue('animMode', value);
    };

    window.applyAnimDuration = function(value) {
      setSettingValue('animDuration', value);
    };

    // 简约模式
    window.toggleSimpleMode = function(enabled) {
      if (enabled) {
        document.documentElement.setAttribute('data-simple-mode', '');
      } else {
        document.documentElement.removeAttribute('data-simple-mode');
      }
      localStorage.setItem('lintiance_simple_mode', String(enabled));
    };

    // 初始化主题按钮
    const stored = localStorage.getItem('rin_theme');
    const theme = stored ? JSON.parse(stored) : 'light';
    document.querySelectorAll('.theme-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.themeValue === theme);
    });

    // 初始化简约模式
    if (localStorage.getItem('lintiance_simple_mode') === 'true') {
      document.documentElement.setAttribute('data-simple-mode', '');
      const toggle = document.getElementById('toggle-minimal');
      if (toggle) toggle.checked = true;
    }

    initControls();

    // 站点配置使用静态值（完全静态站点，无需 API）
    // 站点标题和作者通过 TUI 工具修改 .env / wrangler.toml 后重新构建生效
  })();
</script>