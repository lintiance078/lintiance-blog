---
// ============================================================
// AsciiArt - ASCII 字符画渲染组件
// 使用 <pre> 标签渲染，等宽字体，CSS 适配
// 对 ASCII 文本做简单压缩（去除重复空行）
// ============================================================
export interface Props {
  content: string;
  caption?: string;
  maxWidth?: string;
}

const { content, caption, maxWidth = '100%' } = Astro.props;

// 简单压缩：连续空行合并为单行
const compressed = content
  .split('\n')
  .reduce((acc: string[], line: string, i: number, arr: string[]) => {
    // 如果当前行和上一行都是空行，跳过
    if (i > 0 && line.trim() === '' && arr[i - 1].trim() === '') {
      return acc;
    }
    acc.push(line);
    return acc;
  }, [])
  .join('\n');
---

<div class="ascii-art-wrapper" style="max-width:{maxWidth};">
  <pre class="ascii-art">{compressed}</pre>
  {caption && <p style="text-align:center;font-size:0.8rem;color:var(--text-tertiary);margin-top:0.5rem;">{caption}</p>}
</div>