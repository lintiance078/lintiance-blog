---
// ============================================================
// 首页 - 展示最新文章列表 + 搜索框
// 预渲染静态 HTML
// 同时加载普通文章和黑客文章，前端通过 data-post-type 过滤
// ============================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import type { PostMeta, Pagination } from '@lib/api';

// 从 Astro content collection 获取文章（纯静态模式）
// 同时加载普通文章和黑客文章
const normalPosts = await Astro.glob('../content/posts/*.md');
const hackerPosts = await Astro.glob('../content/hacker-posts/*.md');

// 从 frontmatter 构建文章元数据列表
const postList = [
  ...normalPosts.map(post => ({
    slug: post.frontmatter.slug || post.file.split('/').pop()?.replace('.md', '') || '',
    title: post.frontmatter.title || 'Untitled',
    summary: post.frontmatter.summary || '',
    tags: Array.isArray(post.frontmatter.tags) ? JSON.stringify(post.frontmatter.tags) : '[]',
    cover_image: post.frontmatter.cover || '',
    is_ascii: post.frontmatter.cover_ascii ? 1 : 0,
    created_at: post.frontmatter.date || new Date().toISOString(),
    word_count: post.frontmatter.word_count || 0,
    post_type: 'normal',
  })),
  ...hackerPosts.map(post => ({
    slug: post.frontmatter.slug || post.file.split('/').pop()?.replace('.md', '') || '',
    title: post.frontmatter.title || 'Untitled',
    summary: post.frontmatter.summary || '',
    tags: Array.isArray(post.frontmatter.tags) ? JSON.stringify(post.frontmatter.tags) : '[]',
    cover_image: post.frontmatter.cover || '',
    is_ascii: post.frontmatter.cover_ascii ? 1 : 0,
    created_at: post.frontmatter.date || new Date().toISOString(),
    word_count: post.frontmatter.word_count || 0,
    post_type: 'hacker',
  })),
]
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());

const pageTitle = '林天策 Blog - 首页';
const pageDescription = '记录技术、生活与思考';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="container">
    <div class="page-header">
      <h1 class="page-title">林天策 <span style="color:var(--color-primary);">Blog</span></h1>
      <p class="page-subtitle post-count">共 {normalPosts.length} 篇文章</p>
    </div>

    <!-- 文章列表 -->
    {postList.length === 0 ? (
      <div class="empty-state">
        <div class="empty-state-icon">📝</div>
        <p class="empty-state-text">还没有文章，开始创作吧！</p>
        <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--text-tertiary);">
          使用本地 TUI 工具创建 Markdown 文章
        </p>
      </div>
    ) : (
      <div class="posts-grid" id="posts-grid">
        {postList.map(post => (
          <div data-post-type={post.post_type}>
            <PostCard {...post} />
          </div>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<script>
  // 文章列表模式过滤
  (function() {
    function filterPostsByMode() {
      const isHackerMode = document.documentElement.classList.contains('hacker-mode');
      const postItems = document.querySelectorAll('#posts-grid [data-post-type]');
      const countEl = document.querySelector('.post-count');

      let visibleCount = 0;
      postItems.forEach((item: Element) => {
        const el = item as HTMLElement;
        const postType = el.getAttribute('data-post-type');
        if (isHackerMode) {
          if (postType === 'hacker') { el.style.display = ''; visibleCount++; }
          else { el.style.display = 'none'; }
        } else {
          if (postType === 'normal') { el.style.display = ''; visibleCount++; }
          else { el.style.display = 'none'; }
        }
      });

      if (countEl) {
        countEl.textContent = `共 ${visibleCount} 篇文章`;
      }
    }

    filterPostsByMode();

    const observer = new MutationObserver((mutations) => {
      mutations.forEach(m => {
        if (m.attributeName === 'class') filterPostsByMode();
      });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  })();
</script>