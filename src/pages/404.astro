---
// ============================================================
// 404 页面 - 未找到
// ============================================================
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div class="container">
    <div class="empty-state" style="padding:6rem 2rem;">
      <div class="empty-state-icon" style="font-size:5rem;">🔮</div>
      <h2 style="font-size:1.5rem;margin-bottom:0.5rem;">404 - 页面未找到</h2>
      <p class="empty-state-text">你访问的页面不存在或已被移除</p>
      <div style="margin-top:2rem;display:flex;gap:1rem;justify-content:center;">
        <a href="/" class="btn btn-primary">🏠 返回首页</a>
        <a href="/posts" class="btn">📄 浏览文章</a>
      </div>

      <!-- 搜索建议 -->
      <div style="margin-top:3rem;max-width:400px;margin-left:auto;margin-right:auto;">
        <p style="font-size:0.85rem;color:var(--text-tertiary);margin-bottom:0.75rem;">试试搜索你想要的：</p>
        <div class="search-input-wrapper">
          <span class="search-icon">🔍</span>
          <input
            type="search"
            class="search-input"
            placeholder="搜索文章..."
            onkeydown="if(event.key==='Enter'){window.location='/search?q='+encodeURIComponent(this.value)}"
          />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>