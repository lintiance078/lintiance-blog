---
// ============================================================
// 404 页面 - 友好错误提示
// 全局异常捕获时也显示此页面
// ============================================================
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 - 林天策 Blog" description="该页面正在开发中，敬请期待">
  <div class="container">
    <div class="error-page">
      <div class="error-icon">🔧</div>
      <h1 class="error-title">该页面正在开发中，敬请期待</h1>
      <p class="error-desc">您访问的页面暂未上线或正在建设中。</p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">返回首页</a>
        <a href="/articles" class="btn btn-outline">浏览文章</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    text-align: center;
    padding: 4rem 1rem;
    max-width: 480px;
    margin: 0 auto;
  }
  .error-icon {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }
  .error-title {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .error-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .error-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>