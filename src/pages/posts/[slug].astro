---
// ============================================================
// 文章详情页 - 动态路由 [slug]
// 渲染 Markdown 编译的静态 HTML
// 支持 ASCII 字符画内嵌渲染
// 黑客文章需通过隐秘模式验证才能查看
// ============================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import AsciiArt from '@components/AsciiArt.astro';
import { formatDate, parseTags, estimateReadingTime } from '@lib/utils';

export async function getStaticPaths() {
  const normalPosts = await Astro.glob('../../content/posts/*.md');
  const hackerPosts = await Astro.glob('../../content/hacker-posts/*.md');
  const allPosts = [...normalPosts, ...hackerPosts];
  return allPosts.map(post => ({
    params: {
      slug: post.frontmatter.slug || post.file.split('/').pop()?.replace('.md', '') || '',
    },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, frontmatter } = post;

const title = frontmatter.title || 'Untitled';
const tags = Array.isArray(frontmatter.tags) ? frontmatter.tags : [];
const date = frontmatter.date || new Date().toISOString();
const summary = frontmatter.summary || '';
const wordCount = frontmatter.word_count || 0;
const readingTime = estimateReadingTime(wordCount);
const cover = frontmatter.cover || '';
const coverAscii = frontmatter.cover_ascii || '';

// 检测文章类型：是否来自 hacker-posts 目录
const isHackerPost = post.file.includes('hacker-posts');
---

<BaseLayout title={`${title} - Rin Blog`} description={summary}>
  <!-- 黑客文章保护：未激活黑客模式时显示访问拒绝 -->
  {isHackerPost && (
    <div id="hacker-post-gate" class="hacker-post-gate">
      <div class="hacker-gate-content">
        <div class="hacker-gate-icon">🔒</div>
        <h2>访问受限</h2>
        <p>此内容需要通过隐秘模式验证后才能查看。</p>
        <p class="hacker-gate-hint">在设置面板中连续点击站点名称 5 次，然后在搜索框中输入密钥。</p>
        <a href="/" class="btn btn-primary" style="margin-top:1rem;">返回首页</a>
      </div>
    </div>
  )}

  <article class="article" data-post-type={isHackerPost ? 'hacker' : 'normal'} style={isHackerPost ? 'display:none' : ''}>
    <header class="article-header">
      <h1 class="article-title">{title}</h1>

      <div class="article-meta">
        <span>📅 {formatDate(date)}</span>
        {wordCount > 0 && <span>📖 {readingTime}</span>}
        {wordCount > 0 && <span>📝 {wordCount} 字</span>}
      </div>

      {tags.length > 0 && (
        <div class="post-card-tags" style="justify-content:center;margin-top:1rem;">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="tag">{tag}</a>
          ))}
        </div>
      )}
    </header>

    <!-- 封面图 -->
    {cover && !coverAscii && (
      <img
        src={cover}
        alt={title}
        style="width:100%;max-height:400px;object-fit:cover;border-radius:var(--radius-lg);margin-bottom:2rem;"
        loading="eager"
      />
    )}

    <!-- ASCII 封面 -->
    {coverAscii && (
      <AsciiArt content={coverAscii} caption="ASCII 封面" />
    )}

    <!-- 文章正文 -->
    <div class="article-content">
      <Content />
    </div>

    <!-- 文章底部 -->
    <hr style="margin:3rem 0 1.5rem;" />

    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
      <div style="display:flex;gap:0.5rem;">
        {tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="tag">{tag}</a>
        ))}
      </div>

      <div style="display:flex;align-items:center;gap:1rem;">
        <!-- 本地收藏按钮 -->
        <button
          class="like-btn"
          id="like-btn"
          data-slug={frontmatter.slug}
          onclick="const ls=JSON.parse(localStorage.getItem('rin_likes')||'[]');const s=this.dataset.slug;const i=ls.indexOf(s);if(i>-1){ls.splice(i,1);this.classList.remove('liked');this.innerHTML='🤍 收藏'}else{ls.push(s);this.classList.add('liked');this.innerHTML='❤️ 已收藏'};localStorage.setItem('rin_likes',JSON.stringify(ls))"
        >
          🤍 收藏
        </button>
      </div>
    </div>
  </article>

  <script>
    // 初始化收藏按钮状态
    (function() {
      const btn = document.getElementById('like-btn');
      if (!btn) return;
      const slug = btn.dataset.slug;
      const likes = JSON.parse(localStorage.getItem('rin_likes') || '[]');
      if (likes.includes(slug)) {
        btn.classList.add('liked');
        btn.innerHTML = '❤️ 已收藏';
      }
    })();

    // 黑客文章保护：检测黑客模式状态，决定显示内容还是访问拒绝
    (function() {
      const article = document.querySelector('.article[data-post-type="hacker"]');
      const gate = document.getElementById('hacker-post-gate');
      if (!article || !gate) return;

      // 检查是否已激活黑客模式
      function checkHackerMode() {
        const isHackerMode = document.documentElement.classList.contains('hacker-mode');
        if (isHackerMode) {
          article.style.display = '';
          gate.style.display = 'none';
        } else {
          article.style.display = 'none';
          gate.style.display = '';
        }
      }

      // 初始检查
      checkHackerMode();

      // 监听黑客模式切换（MutationObserver）
      const observer = new MutationObserver(checkHackerMode);
      observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    })();
  </script>
</BaseLayout>